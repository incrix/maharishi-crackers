# Copy to .env.local and fill in. Never commit the filled version.

# --- Storage: DynamoDB + S3 (required in production) -----------------------
# Without these the app writes JSON to disk, which fails on any serverless host.
#
# Create the tables and the bucket with:  node scripts/dynamo-setup.mjs --write
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Every table is named <prefix><name>. It is the only thing separating this
# shop's data from anything else in the same AWS account, so set it explicitly.
DYNAMO_TABLE_PREFIX=maharishi_
# Documents - the price list, the per-order proformas, and admin image uploads
# when Cloudinary is unavailable. NOT DynamoDB: an item there stops at 400 KB.
# Bucket names are global, so this needs to be unique to you.
S3_MEDIA_BUCKET=
S3_MEDIA_PREFIX=media/

# Only the migration script reads this; the app no longer touches MongoDB.
# MONGODB_URI=
# MONGODB_DB=maharishi

# --- Site ------------------------------------------------------------------
# Canonical URLs, sitemap and structured data are built from this.
NEXT_PUBLIC_SITE_URL=https://maharishicrackers.com
# Where product images and the catalogue seed are hosted.
NEXT_PUBLIC_ASSET_BASE=/database

# --- Analytics (optional) --------------------------------------------------
# Your own GA4 measurement ID, e.g. G-XXXXXXXXXX. Analytics is not loaded at
# all while this is unset - deliberately, so traffic can never be reported into
# somebody else's property.
NEXT_PUBLIC_GA_ID=

# --- Images -----------------------------------------------------------------
# Product photos. Uploads are signed server-side; the secret never reaches the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Outgoing mail ---------------------------------------------------------
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USER=noreply@teamincrix.com
MAIL_PASSWORD=
MAIL_NAME=Maharishi Crackers
ORDER_MAIL=
ORDER_MAIL_CC=

# --- Admin auth ------------------------------------------------------------
# Generate both with: node scripts/admin-secrets.mjs
ADMIN_JWT_SECRET=
ADMIN_PASSWORD_HASH=

# --- WhatsApp (WATI) --------------------------------------------------------
# Optional. Without these the app runs exactly as before and simply sends no
# WhatsApp messages — nothing fails.
#
# From WATI: Settings -> API Docs (endpoint + access token)
WHATSAPP_TOKEN=
# WATI tenant endpoint, from Settings -> API Docs in your WATI dashboard.
# Looks like https://live-mt-server.wati.io/<tenant-id>
WHATSAPP_API_URL=
# Where new-order alerts go (the shop's own WhatsApp), any format.
WHATSAPP_SHOP_NUMBER=
WHATSAPP_LANG=en

# WhatsApp only permits free-form messages within 24h of the customer messaging
# you, so order notices must use APPROVED TEMPLATES. WATI matches parameters by
# NAME, so both the template name and its placeholder names must match.
WHATSAPP_TEMPLATE_CONFIRM=order_confirmation
WHATSAPP_TEMPLATE_PACKED=order_packed
WHATSAPP_TEMPLATE_DISPATCH=order_dispatched
WHATSAPP_TEMPLATE_CANCELLED=order_cancelled
WHATSAPP_TEMPLATE_SHOP=new_order_alert

# Testing only: send plain text instead of templates. Works ONLY inside the
# 24-hour window, so use it against your own number before templates land.
WHATSAPP_ALLOW_FREEFORM=false
